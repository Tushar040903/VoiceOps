# =====================================================================
# VoiceOps Environment Configuration Template
# =====================================================================
# Copy this file to .env and insert your real credentials.
# Do NOT commit .env to version control!

# --- Gnani.ai Speech Services (STT & TTS) ---
# Sign up at: https://app.gnani.ai/voice
GNANI_API_KEY=your_gnani_api_key_here
GNANI_STT_LANGUAGE=en-IN
GNANI_TTS_VOICE=Kaveri
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_LANGUAGE=en-IN

# --- LLM API Credentials (Optional) ---
# System automatically uses high-accuracy offline reasoning if keys are omitted.
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# --- Dataset Path (Optional) ---
# Default auto-resolves Capstone_Project_Dataset_FTTT_2026/
# DATASET_PATH=C:/path/to/Capstone_Project_Dataset_FTTT_2026

